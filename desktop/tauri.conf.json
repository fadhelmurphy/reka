{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reka",
  "version": "0.2.0",
  "identifier": "com.fadhelmurphy.reka",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Reka",
        "url": "index.html",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Rekam layar + kamera, bagikan lewat link",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "publisher": "Fadhel Ijlal Falah",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libxtst6"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg",
          "libXtst"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}